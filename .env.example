# AetherGraph Environment Configuration Example
# Copy this file to .env and configure your local or cloud LLM credentials

# 1. Local LLM Server (Ollama / VLLM / LocalAI)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# 2. Cloud LLM API Keys (Optional for deep semantic extraction)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. AetherGraph Daemon Server Settings
AETHER_PORT=9210
AETHER_HOST=0.0.0.0
