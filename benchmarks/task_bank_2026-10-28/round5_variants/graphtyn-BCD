#!/home/calero/Documentos/docker/PROYECTOS/graphtyn/.venv/bin/python3
"""Graphtyn CLI under the 'BCD' flow-budget variant (benchmark only)."""
import sys
from graphtyn.core import retrieval_signals as rs
import graphtyn.mcp_server as ms
VARIANT = "BCD"
if VARIANT == "BCD":
    rs.CHAIN_SHARE, rs.CHAIN_SEEDS, rs.COMMAND_NAMES, rs.OUTLINE_LIMIT = 0.5, 1, True, 12
elif VARIANT == "A":
    rs.FLOW_NODE_CAP = 14
    # The default 10-entity budget becomes 18, as measured in the package benchmark.
    _query, _render = ms.query_intent, ms.evidence_result
    ms.query_intent = lambda graph, request, intent="auto", max_nodes=12: _query(graph, request, intent, 18 if max_nodes == 10 else max_nodes)
    ms.evidence_result = lambda result, max_nodes=24, *a, **k: _render(result, 18 if max_nodes == 10 else max_nodes, *a, **k)
from graphtyn.cli import main
sys.exit(main())
